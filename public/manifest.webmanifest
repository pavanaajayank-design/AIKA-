{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/",
  "name": "AIKA — Explore on Time",
  "short_name": "AIKA",
  "description": "Smart, safety-first layover planner. Explore between flights without missing takeoff.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f6ef",
  "theme_color": "#152c39",
  "orientation": "portrait-primary",
  "categories": [
    "travel",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
