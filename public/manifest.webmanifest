{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/",
  "name": "AIKA — Explore on Time",
  "short_name": "AIKA",
  "description": "A thoughtful AI-powered travel companion that helps travellers turn airport layovers into meaningful discoveries while prioritising their next flight.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f6ef",
  "theme_color": "#152c39",
  "orientation": "portrait-primary",
  "categories": [
    "travel",
    "utilities",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Plan Layover",
      "short_name": "Plan",
      "description": "Start planning an airport layover",
      "url": "/#planner",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Trips",
      "short_name": "Trips",
      "description": "View saved trips and itineraries",
      "url": "/#trips",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    }
  ]
}
