# FRONTEND: demo mode needs no keys; Supabase configuration below is optional.
VITE_SERVICE_MODE=demo
VITE_API_BASE_URL=

# Optional browser-safe Supabase project configuration.
# These values are public; use only the project URL and publishable key.
# Authentication and trip persistence are not connected in this phase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY: used only by the retained full-stack /api routes.
# Never prefix secret keys with VITE_ or NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=
GOOGLE_MAPS_SERVER_API_KEY=
ENABLE_WEATHER=false

# FUTURE BACKEND AUTH / DATABASE: documented names, not yet consumed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# A Supabase URL and publishable key can eventually be public when RLS is configured.
# Do not put a service-role key in browser configuration.
